generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// Categoria da loja: marca de pod (kind "pod") ou outro tipo de produto (kind "outro": acessórios, essências…).
model Brand {
  id        String    @id @default(cuid())
  name      String    @unique
  kind      String    @default("pod")
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  products  Product[]
}

model Product {
  id           String   @id @default(cuid())
  slug         String   @unique // âncora do link direto (#v55)
  name         String
  brandId      String
  brand        Brand    @relation(fields: [brandId], references: [id], onDelete: Restrict)
  puffs        Int?
  series       String   @default("")
  description  String   @default("")
  priceCents   Int? // sem preço = "Consultar"
  promoCents   Int? // preço promocional (menor que priceCents)
  featured     Boolean  @default(false) // aparece nos destaques do início
  photo        Bytes?
  photoMime    String   @default("")
  photoVersion Int      @default(0)
  sortOrder    Int      @default(0)
  active       Boolean  @default(true)
  noFlavor     Boolean  @default(false) // produto sem sabores: um botão "Fazer pedido"
  inStock      Boolean  @default(true) // só vale para produto sem sabores
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  flavors      Flavor[]

  @@index([sortOrder])
}

model Flavor {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String
  available  Boolean  @default(true)
  priceCents Int? // preço próprio do sabor (sobrepõe o do produto)
  promoCents Int?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([productId, sortOrder])
}

model Setting {
  key   String @id
  value String
}

// Imagens soltas do site (logo).
model Asset {
  key       String   @id
  data      Bytes
  mime      String
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
}

// Cliente da loja: entra só com o celular (phoneKey = DDD + número, sem o 55).
model Customer {
  id          String   @id @default(cuid())
  phoneKey    String   @unique
  name        String
  lastAddress Json? // último endereço/localização usado, para o próximo pedido
  createdAt   DateTime @default(now())
  lastLoginAt DateTime @default(now())
  orders      Order[]
}

model Order {
  id             String      @id @default(cuid())
  number         Int         @unique @default(autoincrement())
  customerId     String
  customer       Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerName   String
  phoneKey       String
  street         String
  houseNumber    String
  district       String
  complement     String      @default("")
  reference      String      @default("")
  latitude       Float?
  longitude      Float?
  totalCents     Int // soma dos itens com preço
  consultItems   Int         @default(0) // itens sem preço ("Consultar")
  paymentMethod  String // pix | dinheiro | cartao
  changeForCents Int? // troco para (dinheiro)
  notes          String      @default("")
  status         String      @default("recebido") // recebido | confirmado | em_rota | entregue | cancelado
  paid           Boolean     @default(false)
  cancelReason   String      @default("")
  canceledBy     String      @default("") // cliente | loja
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  confirmedAt    DateTime?
  dispatchedAt   DateTime?
  deliveredAt    DateTime?
  canceledAt     DateTime?
  items          OrderItem[]

  @@index([status, createdAt])
  @@index([phoneKey])
  @@index([createdAt])
}

// Itens com nome e preço do momento do pedido (não mudam se o produto mudar depois).
model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String?
  flavorId       String?
  name           String
  flavorName     String  @default("")
  unitPriceCents Int? // null = "Consultar"
  quantity       Int
  totalCents     Int?

  @@index([orderId])
}
